{
  "name": "obsidian-github-image-uploader",
  "version": "0.1.0",
  "description": "Upload pasted or dropped images to a GitHub repository and insert the public link into your note.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "install-local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "github",
    "image",
    "upload"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
